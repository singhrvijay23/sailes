# From the Partner Dashboard (Apps → SAILES → Client credentials), or `shopify app env show`.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Public https URL of this app (a tunnel such as `shopify app dev` or cloudflared in development).
SHOPIFY_APP_URL=https://shopify.sailes.ai
SHOPIFY_API_VERSION=2026-10
# Optional: theme app extension id for the theme-editor deep link (defaults to the API key).
SHOPIFY_THEME_EXTENSION_ID=
# SAILES API (for the code exchange) and console (where merchants approve the connection).
SAILES_API_URL=https://api.sailes.ai
SAILES_CONSOLE_URL=https://app.sailes.ai
# Postgres for shop records. Leave empty in development to keep them in memory.
DATABASE_URL=
# 32 random bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=
RESYNC_HOURS=24
