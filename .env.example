# Copy to .env at the repo root. All values below are local-development defaults.

# --- API ---
PORT=4000
DATABASE_URL=postgres://sailes:sailes@localhost:5432/sailes
REDIS_URL=redis://localhost:6379
# Long random string. Signs console sessions.
JWT_SECRET=change-me-to-a-long-random-string
# 32 random bytes, base64. Encrypts merchant AI keys. Generate: openssl rand -base64 32
# Never change it after keys are stored (they could no longer be decrypted). Production uses AWS KMS.
SAILES_MASTER_KEY=
# Public URL of this API (used in the embed snippet) and the console origin (always allowed for test chats).
PUBLIC_API_URL=http://localhost:4000
CONSOLE_ORIGIN=http://localhost:3000
# Run background embedding jobs inside the API process.
RUN_WORKERS=true

# --- SAILES AI (managed credits) ---
# Our own provider key, used for merchants on managed AI. Leave empty to hide the option.
MANAGED_AI_PROVIDER=openai
MANAGED_AI_API_KEY=

# --- Stripe billing (leave empty to disable billing; plans can then be switched directly) ---
# Test-mode keys from dashboard.stripe.com. Webhook endpoint: <PUBLIC_API_URL>/v1/billing/webhook
# For local testing: stripe listen --forward-to localhost:4000/v1/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring price ids (price_...) for each plan and interval
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=
# SAILES AI credits are charged at estimated provider cost times this
CREDIT_MARKUP=2

# --- Production only ---
# AWS KMS key that wraps AI-key data keys (replaces SAILES_MASTER_KEY for new keys)
KMS_KEY_ID=
# CA bundle to verify the database TLS certificate (set in the Docker image)
DATABASE_CA_FILE=

# --- Console (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
